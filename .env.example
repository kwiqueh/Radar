# Режим demo использует только синтетические данные и не обращается к биржам.
SKIN_RADAR_MODE=demo
SKIN_RADAR_DATABASE_PATH=skin_radar.db
SKIN_RADAR_HOST=127.0.0.1
SKIN_RADAR_PORT=8000
SKIN_RADAR_SCAN_INTERVAL_SECONDS=370

# Денежные настройки. Проверьте комиссии своего способа оплаты/вывода.
SKIN_RADAR_BUDGET_RUB=5000
SKIN_RADAR_RESERVE_RUB=500
SKIN_RADAR_MAX_ITEM_PRICE_RUB=4000
SKIN_RADAR_MIN_PROFIT_RUB=150
SKIN_RADAR_MIN_ROI_PCT=8
SKIN_RADAR_MIN_LIQUIDITY_SCORE=20
SKIN_RADAR_MAX_QUOTE_AGE_SECONDS=900
SKIN_RADAR_MAX_HOLD_HOURS=168
SKIN_RADAR_USD_RUB=90
SKIN_RADAR_EUR_RUB=98
# Пример курсов выше — только для demo. В live нужны реальные курсы и время проверки:
SKIN_RADAR_FX_VERIFIED_AT=
SKIN_RADAR_MAX_FX_AGE_HOURS=24
SKIN_RADAR_FEES_FILE=fees.local.json
SKIN_RADAR_ALLOW_UNKNOWN_LIQUIDITY=true
SKIN_RADAR_ALLOW_UNKNOWN_HOLD=false
# Оставьте false, пока не проверены актуальные условия доступа/использования API.
SKIN_RADAR_API_TERMS_ACCEPTED=false
SKIN_RADAR_CSFLOAT_API_KEY=

# Следующие общие комиссии применяются только в demo. В live используется FEES_FILE.
SKIN_RADAR_PURCHASE_FEE_PCT=0
SKIN_RADAR_FUNDING_FEE_PCT=3
SKIN_RADAR_SELLER_FEE_PCT=12
SKIN_RADAR_WITHDRAWAL_FEE_PCT=3
SKIN_RADAR_FIXED_COST_RUB=0
SKIN_RADAR_UNEXPECTED_COST_RESERVE_PCT=2

# Реальный режим: объявления CSFloat/Skinport и справочный RUB-каталог Market.CSGO.
SKIN_RADAR_ENABLED_PROVIDERS=csfloat,skinport,market_csgo
SKIN_RADAR_EXCLUDED_ITEMS=
SKIN_RADAR_CSFLOAT_PAGES=2
SKIN_RADAR_HTTP_CONCURRENCY=4

# Telegram необязателен. Никогда не коммитьте заполненный .env.
SKIN_RADAR_TELEGRAM_BOT_TOKEN=
SKIN_RADAR_TELEGRAM_CHAT_ID=
